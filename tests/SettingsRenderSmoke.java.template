import __RENDER_PIPELINE__;
import dev.danzaa.stockpile.StockpileClient;
import dev.danzaa.stockpile.StockpileConfig;
import dev.danzaa.stockpile.StockpileSettingsScreen;
import java.io.File;
import java.lang.reflect.Field;
import net.minecraft.client.Minecraft;
import net.minecraft.client.Options;
import net.minecraft.client.gui.Font;
import net.minecraft.client.gui.Gui;
import net.minecraft.client.gui.GuiGraphicsExtractor;
import net.minecraft.client.gui.Hud;
import net.minecraft.client.multiplayer.ClientLevel;
import net.minecraft.client.renderer.state.gui.GuiRenderState;
import net.minecraft.network.chat.Component;
import net.minecraft.resources.Identifier;
import sun.misc.Unsafe;

public final class SettingsRenderSmoke {
    private static final Unsafe UNSAFE;
    static {
        try { Field f=Unsafe.class.getDeclaredField("theUnsafe");f.setAccessible(true);UNSAFE=(Unsafe)f.get(null); }
        catch(Exception e){throw new ExceptionInInitializerError(e);}
    }
    private static <T> T blank(Class<T> cls)throws Exception{return cls.cast(UNSAFE.allocateInstance(cls));}
    private static void field(Object target,Class<?> cls,String name,Object value)throws Exception{
        Field f=cls.getDeclaredField(name);f.setAccessible(true);f.set(target,value);
    }
    public static final class BlurOptions extends Options {
        public BlurOptions(){super(null,new File("."));}
        @Override public int getMenuBackgroundBlurriness(){return 5;}
    }
    public static final class Graphics extends GuiGraphicsExtractor {
        GuiRenderState state;
        int blurs,texts;
        public Graphics(){super(null,null,0,0);}
        @Override public void nextStratum(){state.nextStratum();}
        @Override public void blurBeforeThisStratum(){blurs++;state.blurBeforeThisStratum();}
        @Override public void extractDeferredElements(int x,int y,float delta){}
        @Override public void centeredText(Font font,String text,int x,int y,int color){texts++;}
        @Override public void centeredText(Font font,Component text,int x,int y,int color){texts++;}
        @Override public void blit(RenderPipeline pipeline,Identifier texture,int x,int y,float u,float v,int width,int height,int textureWidth,int textureHeight){}
    }
    public static void main(String[] args)throws Exception{
        net.minecraft.SharedConstants.tryDetectVersion();net.minecraft.server.Bootstrap.bootStrap();
        Minecraft client=blank(Minecraft.class);
        Field instance=Minecraft.class.getDeclaredField("instance");instance.setAccessible(true);Object previous=instance.get(null);instance.set(null,client);
        try{
            field(client,Minecraft.class,"options",blank(BlurOptions.class));
            field(client,Minecraft.class,"level",blank(ClientLevel.class));
            Gui gui=blank(Gui.class);field(gui,Gui.class,"hud",blank(Hud.class));field(client,Minecraft.class,"gui",gui);
            StockpileClient owner=new StockpileClient();StockpileConfig config=new StockpileConfig();config.keybindEnabled=false;
            field(owner,StockpileClient.class,"config",config);
            StockpileSettingsScreen screen=new StockpileSettingsScreen(null,owner);screen.width=427;screen.height=240;
            for(int frame=0;frame<2;frame++){
                Graphics graphics=blank(Graphics.class);graphics.state=new GuiRenderState();
                screen.extractRenderStateWithTooltipAndSubtitles(graphics,0,0,0);
                if(graphics.blurs!=1)throw new AssertionError("Expected exactly one vanilla background blur, got "+graphics.blurs);
                if(graphics.texts!=3)throw new AssertionError("Settings text did not render");
            }
            System.out.println("Settings render lifecycle passed: 2 frames, one blur per frame, settings text rendered");
        }finally{instance.set(null,previous);}
    }
}
